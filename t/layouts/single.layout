[gtk4 single]
Type=G
VBroot= SBscroll FRframe EBexpand ABalign WBevent
SBscroll= Label(text="scrolled")
FRframe= (label="framed",shadow=in) Label2(text="in frame")
EBexpand= (label="more",expand=1) Label3(text="expanded")
ABalign= (xscale=0,xalign=1,yscale=0,yalign=0) Label4(text="aligned")
WBevent= Label5(text="evented")
